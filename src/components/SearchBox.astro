---
// Search Component - AI-Powered Search
// Static keyword index (instant) + DeepSeek AI answers via /api/chat (小冈)
---

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="relative">
    <input
      type="text"
      id="searchInput"
      placeholder="搜索冈仁波齐… 例如：转山装备、高原反应、马年"
      class="w-full px-6 py-4 pl-14 bg-white/90 backdrop-blur-sm border border-white/30 rounded-full text-kailash-dark placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-kailash-dark focus:border-transparent transition"
      autocomplete="off"
    />
    <input
      type="text"
      id="searchInputEn"
      placeholder="Search Kailash… e.g. gear, altitude, kora"
      class="w-full px-6 py-4 pl-14 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-kailash-gold focus:border-transparent transition hidden"
      autocomplete="off"
    />
    <svg class="absolute left-5 top-1/2 -translate-y-1/2 w-5 h-5 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>
    <button id="searchBtn" class="absolute right-2 top-1/2 -translate-y-1/2 bg-kailash-gold text-kailash-dark px-4 py-2 rounded-full font-medium hover:bg-kailash-accent transition">
      <span data-lang-content="zh">搜索</span>
      <span data-lang-content="en" style="display: none;">Search</span>
      <span data-lang-content="hi" style="display: none;">खोजें</span>
      <span data-lang-content="ja" style="display: none;">検索</span>
    </button>
  </div>

  <!-- 热门问题 Hot Chips -->
  <div id="hotChips" class="flex flex-wrap gap-2 mt-4 justify-center">
    <button class="hot-chip" data-lang="zh" data-q="转山需要准备什么装备？">🎒 转山装备</button>
    <button class="hot-chip" data-lang="zh" data-q="高原反应怎么预防和应对？">⚠️ 高反应对</button>
    <button class="hot-chip" data-lang="zh" data-q="2026年马年转山有什么特别？">🐎 马年转山</button>
    <button class="hot-chip" data-lang="zh" data-q="外圈52公里3天怎么走？">🗺️ 路线规划</button>
    <button class="hot-chip" data-lang="zh" data-q="从拉萨到冈仁波齐怎么去？">🚙 怎么去</button>
    <button class="hot-chip" data-lang="zh" data-q="转山大概要花多少钱？">💰 费用预算</button>
    <button class="hot-chip" data-lang="en" data-q="What gear do I need for the kora?" style="display: none;">🎒 Packing list</button>
    <button class="hot-chip" data-lang="en" data-q="How to prevent altitude sickness?" style="display: none;">⚠️ Altitude sickness</button>
    <button class="hot-chip" data-lang="en" data-q="What is special about Horse Year 2026 kora?" style="display: none;">🐎 Horse Year 2026</button>
    <button class="hot-chip" data-lang="en" data-q="How to plan the 52km kora in 3 days?" style="display: none;">🗺️ Kora route</button>
    <button class="hot-chip" data-lang="en" data-q="How to get to Mount Kailash from Lhasa?" style="display: none;">🚙 Getting there</button>
    <button class="hot-chip" data-lang="en" data-q="How much does the kora cost?" style="display: none;">💰 Cost</button>
  </div>

  <!-- Search Results Dropdown -->
  <div id="searchResults" class="hidden mt-2 bg-white rounded-xl shadow-lg overflow-hidden text-left">

    <!-- AI Answer Section -->
    <div id="aiSection" class="hidden border-b border-gray-100 bg-gradient-to-br from-kailash-light/60 to-white">
      <div class="flex items-center justify-between px-4 pt-3 pb-1">
        <span class="text-xs font-bold text-kailash-dark uppercase tracking-wide">🤖 <span data-lang-content="zh">AI智能回答 · 小冈</span><span data-lang-content="en" style="display: none;">AI Answer · Xiaogang</span><span data-lang-content="hi" style="display: none;">AI उत्तर · शियाओगांग</span><span data-lang-content="ja" style="display: none;">AI回答 · シャオガン</span></span>
        <span id="aiBadge" class="text-[10px] text-gray-400"></span>
      </div>
      <div id="aiAnswer" class="px-4 pb-2 text-sm text-gray-700 leading-relaxed"></div>
      <div class="px-4 pb-3 flex items-center gap-4 flex-wrap">
        <button id="aiRetry" class="hidden text-xs text-kailash-gold font-medium hover:underline">↻ <span data-lang-content="zh">重新生成</span><span data-lang-content="en" style="display: none;">Regenerate</span><span data-lang-content="hi" style="display: none;">फिर से बनाएं</span><span data-lang-content="ja" style="display: none;">再生成</span></button>
        <span class="text-[10px] text-gray-300">AI生成内容仅供参考</span>
      </div>
    </div>

    <!-- Static Results -->
    <div id="staticWrap" class="max-h-72 overflow-y-auto">
      <div class="p-4 text-gray-500 text-sm" id="searchEmpty">
        <span data-lang-content="zh">输入关键词搜索…</span>
        <span data-lang-content="en" style="display: none;">Type keywords to search…</span>
      </div>
      <div id="searchCount" class="hidden px-4 pt-3 text-xs text-gray-400"></div>
      <div id="searchResultsList" class="hidden">
        <!-- Results will be populated by JavaScript -->
      </div>
      <div id="searchFallback" class="hidden p-4">
        <p class="text-gray-500 text-sm mb-3">
          <span data-lang-content="zh">没有找到相关页面，让小冈AI直接回答你 👇</span>
          <span data-lang-content="en" style="display: none;">No matching pages. Ask 小冈 AI directly 👇</span>
          <span data-lang-content="hi" style="display: none;">कोई पृष्ठ नहीं मिला। शियाओगांग AI से पूछें 👇</span>
          <span data-lang-content="ja" style="display: none;">該当ページがありません。シャオガンAIに聞く 👇</span>
        </p>
        <button id="askAiBtn" class="bg-kailash-dark text-white text-sm px-4 py-2 rounded-full font-medium hover:bg-kailash-stone transition">🤖 <span data-lang-content="zh">问问小冈</span><span data-lang-content="en" style="display: none;">Ask Xiaogang</span><span data-lang-content="hi" style="display: none;">शियाओगांग से पूछें</span><span data-lang-content="ja" style="display: none;">シャオガンに聞く</span></button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .hot-chip {
    font-size: 0.75rem;
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    border: 1px solid rgba(15,14,13,0.25);
    background: rgba(255,255,255,0.55);
    color: #3b2f23;
    cursor: pointer;
    transition: all 0.2s;
    backdrop-filter: blur(4px);
  }
  .hot-chip:hover {
    border-color: #8B6914;
    color: #8B6914;
    background: rgba(255,255,255,0.85);
  }
  .ai-dot {
    width: 6px;
    height: 6px;
    background: #B8956A;
    border-radius: 50%;
    display: inline-block;
    animation: aiBounce 1.2s infinite ease-in-out both;
  }
  .ai-dot:nth-child(2) { animation-delay: -0.4s; }
  .ai-dot:nth-child(3) { animation-delay: -0.2s; }
  @keyframes aiBounce {
    0%, 80%, 100% { transform: scale(0.55); opacity: 0.4; }
    40% { transform: scale(1); opacity: 1; }
  }
  .ai-thinking {
    display: flex;
    align-items: center;
    gap: 4px;
    color: #9a8c7a;
    padding: 0.35rem 0;
  }
</style>

