      '时间规划': '📅', '装备准备': '🎒', '证件办理': '📋', '交通方式': '🚙', '预算规划': '💰',
      '住宿信息': '🏨', '饮食信息': '🍜', '补给信息': '⛽', '装备': '🥾', '宗教': '⛩️',
      '历史人物': '👤', '经典文献': '📜', '套餐服务': '✨', '电子书': '📖', '咨询服务': '💼',
      'AI服务': '🤖', '互动': '💌', '博客': '✍️', '人文地理': '🏞️', '马年专题': '🐎'
    };

    // ============ ELEMENTS ============
    const inputZh = document.getElementById('searchInput');
    const inputEn = document.getElementById('searchInputEn');
    const btn = document.getElementById('searchBtn');
    const results = document.getElementById('searchResults');
    const listEl = document.getElementById('searchResultsList');
    const countEl = document.getElementById('searchCount');
    const emptyEl = document.getElementById('searchEmpty');
    const fallbackEl = document.getElementById('searchFallback');
    const askAiBtn = document.getElementById('askAiBtn');
    const aiSection = document.getElementById('aiSection');
    const aiAnswer = document.getElementById('aiAnswer');
    const aiBadge = document.getElementById('aiBadge');
    const aiRetry = document.getElementById('aiRetry');
    const hotChips = document.querySelectorAll('.hot-chip');

    // ============ STATE ============
    let activeLang = document.documentElement.getAttribute('data-lang') || 'zh';
    let staticTimer = null;
    let aiTimer = null;
    let aiController = null;
    let aiCooldownUntil = 0;   // client-side cooldown (ms) to protect rate limit
    let lastAiQuery = '';
    let lastQuery = '';

    const AI_COOLDOWN_MS = 8000;

    function getActiveInput() { return activeLang === 'en' ? inputEn : inputZh; }
    function getValue() { const i = getActiveInput(); return i ? i.value.trim() : ''; }
    function isQuestion(q) {
      return /[?？]$/.test(q) || /(怎么|如何|什么|多少|可以|需要|注意|准备|哪里|何时|why|how|what|when|where|can|should|need)/i.test(q);
    }

    // ============ LANGUAGE WATCH ============
    function syncInputs() {
      // zh -> zh input; en/hi/ja -> en input (fallback since index data is zh/en)
      const showZh = activeLang === 'zh';
      const showEn = activeLang !== 'zh';
      inputZh.classList.toggle('hidden', !showZh);
      inputEn.classList.toggle('hidden', !showEn);
      hotChips.forEach(c => {
        const chipLang = c.getAttribute('data-lang');
        c.style.display = (chipLang === 'zh' && activeLang === 'zh') || (chipLang === 'en' && activeLang !== 'zh') ? '' : 'none';
      });
    }
    syncInputs();
    const mo = new MutationObserver(() => {
      const lang = document.documentElement.getAttribute('data-lang') || 'zh';
      if (lang !== activeLang) {
        activeLang = lang;
        syncInputs();
        const v = getValue();
        if (v.length) performSearch(v); else hideAll();
      }
    });
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-lang'] });

    // ============ HELPERS ============
    function escapeHtml(s) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function highlight(text, query) {
      const esc = escapeHtml(text);
      const q = (query || '').trim().toLowerCase();
      if (!q || q.length < 2) return esc;
      const idx = esc.toLowerCase().indexOf(q);
      if (idx === -1) return esc;
      const qEsc = esc.slice(idx, idx + q.length);
      return esc.slice(0, idx) + '<mark class="bg-kailash-gold/30 rounded px-0.5">' + qEsc + '</mark>' + esc.slice(idx + q.length);
    }

    function formatAI(text) {
      const lines = escapeHtml(text).split('\n');
      let html = '';
      let inList = false;
      for (let raw of lines) {
        let line = raw.trim();
        if (!line) {
          if (inList) { html += '</div>'; inList = false; }
          continue;
        }
        line = line.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        line = line.replace(/\*(.+?)\*/g, '<em>$1</em>');
        if (/^[-•·]\s+/.test(line)) {
          if (!inList) { html += '<div class="mt-1.5 space-y-1">'; inList = true; }
          html += '<div class="flex gap-2"><span class="text-kailash-gold flex-shrink-0">•</span><span>' + line.replace(/^[-•·]\s+/, '') + '</span></div>';
        } else if (/^\d+[.、)]\s+/.test(line)) {
          if (!inList) { html += '<div class="mt-1.5 space-y-1">'; inList = true; }
          html += '<div class="flex gap-2"><span class="text-kailash-gold flex-shrink-0">' + line.match(/^\d+/)[0] + '.</span><span>' + line.replace(/^\d+[.、)]\s+/, '') + '</span></div>';
        } else {
          if (inList) { html += '</div>'; inList = false; }
          html += '<p class="mt-1.5 first:mt-0">' + line + '</p>';
        }
      }
      if (inList) html += '</div>';
      return html;
    }

    function t(zh, en, hi, ja) {
      if (activeLang === 'en') return en;
      if (activeLang === 'hi') return hi;
      if (activeLang === 'ja') return ja;
      return zh;
    }

    function showTyping() {
      aiSection.classList.remove('hidden');
      aiBadge.textContent = '';
      aiRetry.classList.add('hidden');
      aiAnswer.innerHTML = '<div class="ai-thinking"><span class="ai-dot"></span><span class="ai-dot"></span><span class="ai-dot"></span>&nbsp;' + t('小冈正在思考…', 'Xiaogang is thinking…', 'शियाओगांग सोच रहा है…', 'シャオガンが考えています…') + '</div>';
    }

    // ============ AI ANSWER ============
    async function askAI(query, force) {
      if (!query || query.length < 2) return;
      const now = Date.now();
      // Skip auto calls during cooldown; force (button/Enter) bypasses cooldown but not repeated identical queries
      if (!force && now < aiCooldownUntil) return;
      if (query === lastAiQuery && aiController) return;

      if (aiController) aiController.abort();
      aiController = new AbortController();
      lastAiQuery = query;
      showTyping();

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: [{ role: 'user', content: query }] }),
          signal: aiController.signal,
        });
        aiCooldownUntil = Date.now() + AI_COOLDOWN_MS;

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.error || 'AI服务暂时不可用');
        }
        const data = await res.json();
        if (!data.reply) throw new Error('空回复');
        aiAnswer.innerHTML = formatAI(data.reply);
        aiBadge.textContent = '⚡ ' + (data.reply.length > 60 ? t('摘要回答', 'Summary', 'सारांश', '要約') : t('已回复', 'Answered', 'उत्तर दिया गया', '回答済み'));
        aiRetry.classList.remove('hidden');
      } catch (e) {
        if (e.name === 'AbortError') return;
        aiAnswer.innerHTML = '<p class="text-gray-400">😅 ' + t('小冈暂时没回答上来，稍后再试试。', 'Xiaogang could not answer right now, try again later.', 'शियाओगांग अभी उत्तर नहीं दे सका, बाद में फिर कोशिश करें।', 'シャオガンは今答えることができませんでした。後でもう一度お試しください。') + '</p>';
        aiBadge.textContent = '';
        aiRetry.classList.remove('hidden');
      }
    }

    // ============ STATIC SEARCH ============
    function matches(item, query) {
      const q = query.toLowerCase().trim();
      if (!q) return false;
      // token match (space-separated)
      const tokens = q.split(/\s+/).filter(Boolean);
      if (tokens.length > 1) {
        return tokens.every(tok =>
          item.title.toLowerCase().includes(tok) ||
          item.titleEn.toLowerCase().includes(tok) ||
          item.keywords.some(k => k.toLowerCase().includes(tok))
        );
      }
      const keywordMatch = item.keywords.some(k => k.toLowerCase().includes(q));
      const titleMatch = item.title.toLowerCase().includes(q) || item.titleEn.toLowerCase().includes(q);
      // Chinese fuzzy: all query chars present across title/keywords
      const chars = q.split('');
      const fuzzyMatch = /[\u4e00-\u9fff]/.test(q) && chars.every(ch =>
        item.title.includes(ch) || item.keywords.some(k => k.includes(ch))
      );
      return keywordMatch || titleMatch || fuzzyMatch;
    }

    function renderStatic(query) {
      const q = query.toLowerCase().trim();
      const found = searchData.filter(item => matches(item, q));
      const unique = found.filter((item, idx, self) => idx === self.findIndex(t => t.url === item.url));

      const hasResults = unique.length > 0;
      listEl.classList.toggle('hidden', !hasResults);
      // emptyEl: only the initial "type to search" hint when nothing typed
      emptyEl.classList.toggle('hidden', q.length > 0);
      // fallback: show "ask AI" only when a query exists but no static results
      fallbackEl.classList.toggle('hidden', hasResults || q.length === 0);
      countEl.classList.toggle('hidden', !hasResults);
      if (hasResults) {
        countEl.textContent = '找到 ' + unique.length + ' 条相关结果';
        const grouped = unique.reduce((acc, it) => {
          (acc[it.category] = acc[it.category] || []).push(it);
          return acc;
        }, {});
        let html = '';
        for (const [cat, items] of Object.entries(grouped)) {
          const icon = CATEGORY_ICONS[cat] || '🔍';
          html += '<div class="px-4 py-2 bg-gray-50 text-xs font-semibold text-gray-500 uppercase">' + icon + ' ' + escapeHtml(cat) + '</div>';
          html += items.map(it => `
            <a href="${it.url}" class="block p-3 hover:bg-kailash-light transition border-b border-gray-100 last:border-0">
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-medium text-kailash-dark">${highlight(it.title, q)}</p>
                  <p class="text-sm text-gray-500">${highlight(it.titleEn, q)}</p>
                </div>
                <svg class="w-5 h-5 text-kailash-gold flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </a>
          `).join('');
        }
        listEl.innerHTML = html;
      } else {
        listEl.innerHTML = '';
      }
    }

    // ============ MAIN SEARCH ============
    function performSearch(query, forceAi) {
      const q = (query || '').trim();
      lastQuery = q;

      if (aiTimer) { clearTimeout(aiTimer); aiTimer = null; }

      if (!q) { hideAll(); return; }

      results.classList.remove('hidden');
      renderStatic(q);

      // AI answer: delay slightly so static results show first; forceAi (Enter/btn) goes immediately
      if (forceAi) {
        askAI(q, true);
      } else {
        aiTimer = setTimeout(() => askAI(q, false), 700);
      }
    }

    function hideAll() {
      results.classList.add('hidden');
      if (aiTimer) { clearTimeout(aiTimer); aiTimer = null; }
      if (aiController) { aiController.abort(); aiController = null; }
      aiSection.classList.add('hidden');
    }

    // ============ EVENTS ============
    let debounceTimer;
    [inputZh, inputEn].forEach(input => {
      if (!input) return;
      input.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => performSearch(e.target.value), 180);
      });
      input.addEventListener('focus', () => {
        if (input.value.trim().length >= 1) performSearch(input.value);
      });
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          performSearch(input.value, true);
        }
      });
    });

    btn.addEventListener('click', () => performSearch(getValue(), true));

    askAiBtn.addEventListener('click', () => askAI(lastQuery, true));

    aiRetry.addEventListener('click', () => askAI(lastAiQuery || lastQuery, true));

    hotChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const q = chip.getAttribute('data-q') || '';
        const input = getActiveInput();
        if (input) input.value = q;
        performSearch(q, true);
      });
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      const wrap = document.getElementById('searchResults');
      if (!wrap) return;
      const box = wrap.closest('.max-w-2xl');
      if (box && !box.contains(e.target)) wrap.classList.add('hidden');
    });
  })();
</script>
